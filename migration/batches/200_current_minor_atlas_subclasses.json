  "focused_source_review": {
    "outcome": "Read the complete current atlas definitions and proofs, the complementary leaf-alignment/tree and closure-interval proofs, and the peripheral chordal-sun proof. New definitions preserve full actual-cube budgets, existential joint laws, fixed parameters, ambient constants and empty complementary shores.",
    "identity_decisions": [
      "Bouq± is the existing signed-coordinate conditional_antimatroid graph class, not a new node. A characterization and equivalence connect the new terminology to the existing primary definition.",
      "ACC reuses acc_graphs; its p/c/pc closure is now established by the atlas proof.",
      "Add parameterized E_k and Pos_k entries alongside the fixed E_1, E_2 and Pos_3 nodes, and separate U_k and chunk P_k from maximum-parent decomposition levels."
    ],
    "closest_existing_result": "The old graph map covered 22 Ample-family rows from the original 24-family atlas. The new reviewed map covers all 35 Ample-family rows of the current 37-family atlas and checks all 80 relationships, including noncontainment and strictness. Signed-ideal inclusion into bouquets is strengthened to strict inclusion using the already catalogued 26-set nonrealizable bouquet.",
    "proof_block_hashes": "migration/certificates/200_minor_atlas_subclasses/proof_blocks.json"
  },
  "source_preservation": {
    "policy": "Separate targeted current-atlas freeze. The original seed inventory, numbered JSON locators, source manifest and previous batch files remain unchanged. No LaTeX source or PDF is modified.",
    "ownership": "The database owns the accepted normalized definitions, relationships and concise proofs. All paper formulations, full proofs, exposition and research state remain LaTeX-owned. No catalogue consumer is replaced.",
    "historical_audit": "The original manuscript-label audit remains 816/1143 with minor-atlas 37/37 at its historical freeze; it does not claim full coverage of the expanded current atlas."
  },
