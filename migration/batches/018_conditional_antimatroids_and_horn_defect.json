  "claim_decisions": [
    {
      "claim": "Conditional antimatroids and convex-geometry ideals are the same class.",
      "decision": "Rejected. CCK identifies conditional antimatroids with bouquets of convex geometries and proves every ideal is a bouquet, while Proposition 4 gives an oriented bouquet that is not an ideal."
    },
    {
      "claim": "CCK Proposition 4 proves strict containment for the signed-coordinate graph classes.",
      "decision": "Not asserted. The database records the graph-class inclusion and preserves the stronger non-ideal statement on the displayed oriented example; arbitrary reflections require separate evidence."
    },
    {
      "claim": "Every conditional antimatroid is affine-convex realizable.",
      "decision": "Refuted by the exact twenty-six-set bouquet and its strict ratio-cycle proof."
    }
