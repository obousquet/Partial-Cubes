  "claim_decisions": [
    {
      "claim": "Cover-recursively peripheral and ordinary tree-like partial cubes are the same class.",
      "decision": "Rejected. Ordinary tree-like construction recurses only on contraction bases. Rper recurses on both the base and duplicated site; the bad-site expansion has a C6 site and separates them."
    },
    {
      "claim": "The forbidden basis can be represented only by the punctured cubes.",
      "decision": "Rejected. Those are exactly the nonample obstructions. The ample pc-minimal periphery-free family is a second exact family and contains P5."
    },
    {
      "claim": "The complete ample obstruction family should be presented as a finite list.",
      "decision": "Not asserted. It receives an exact coordinate-state predicate; named infinite subfamilies and deeper repair theorems remain in the source manuscript for later batches."
    },
    {
      "claim": "The P5 census reports independently replay the full enumeration.",
      "decision": "Qualified. The database-owned verifier replays P5 and validates compact report hashes and counts. Full candidate generation and large raw archives remain LaTeX-owned."
    }
  ],
