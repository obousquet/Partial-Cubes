@article {BBC12,
    author       = {Balakrishnan, Kannan and Bresar, Bo\v{s}tjan and Changat, Manoj and Klav\v{z}ar, Sandi and Peterin, Iztok and Subhamathi, Ajitha R.},
    title        = {Almost self-centered median and chordal graphs.},
    year         = {2012},
    journal      = {Taiwanese Journal of Mathematics},
    volume       = {16},
    number       = {5},
    issn         = {1027-5487},
    pages        = {1911-1922},
    publisher    = {The Mathematical Society of the Republic of China (Taiwan), Chung-Li},
    abstract     = {Summary: Almost self-centered graphs were recently introduced as the graphs with exactly two non-central vertices. In this paper we characterize almost self-centered graphs among median graphs and among chordal graphs. In the first case $P_4$ and the graphs obtained from hypercubes by attaching to them a single leaf are the only such graphs. Among chordal graph the variety of almost self-centered graph is much richer, despite the fact that their diameter is at most 3. We also discuss almost self-centered graphs among partial cubes and among $k$-chordal graphs, classes of graphs that generalize median and chordal graphs, respectively. Characterizations of almost self-centered graphs among these two classes seem elusive.},
    msc2010      = {05C12 (05C75 90B80)},
    identifier   = {1252.05048},
}
 
